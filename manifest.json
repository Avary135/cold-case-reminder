{
  "manifest_version": 3,
  "name": "Cold Case Reminder",
  "version": "1.4",
  "description": "Daily cold case notifications and reminders.",
  "permissions": [
    "notifications",
    "tabs",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon128.png"
  },
  "icons": {
    "128": "icon128.png"
  }
}
